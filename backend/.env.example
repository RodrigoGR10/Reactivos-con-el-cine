# Copiar este archivo como .env dentro de backend/
# y completar los valores correspondientes al entorno local.

# Entorno de ejecución
NODE_ENV=development
HOST=localhost
PORT=3001

# Frontend: origen permitido para CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# Configuración del entorno Nix local del proyecto (puerto 5433).
DATABASE_URL=postgresql://postgres@localhost:5433/cine
DATABASE_SCHEMA=public

# Autenticación
# Generar una clave propia con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# TMDB (opcional)
# Necesaria para sincronizar y completar metadatos desde TMDB.
TMDB_API_KEY=
