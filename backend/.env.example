# Copiar este archivo a .env dentro de backend y completar los valores propios.
NODE_ENV=development
HOST=localhost
PORT=3001
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=reactivos-cine

# Obligatorio al usar fullstack: un prefijo propio del grupo, como reactivos7059_.
# Dejar vacio para conservar los nombres actuales en la base local.
MONGODB_COLLECTION_PREFIX=

# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Para la integracion con TMDB de las ramas pendientes; no se usa aun en hito2.
TMDB_API_KEY=
